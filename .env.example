# Клиент: локальный путь к API приложения, доступный браузеру.
VITE_API_BASE_URL=/api

# Сервер: ключ внешнего API. Значение укажите в .env.local.
FAVORIT_API_KEY=

# Сервер: адрес внешнего API. Значение укажите в .env.local.
FAVORIT_API_URL=

# Локальный сервер собранного приложения (npm start).
HOST=127.0.0.1
PORT=3000
